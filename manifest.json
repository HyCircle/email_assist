{
  "manifest_version": 3,
  "name": "Email Assistant",
  "version": "0.2.0",
  "description": "Local-first email drafting assistant for Gmail and Outlook Web.",
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://pc-yh:8070/*",
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.cloud.microsoft/mail/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_icon": "icon-128.png",
    "default_title": "Email Assistant"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content-gmail.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://outlook.live.com/mail/*", "https://outlook.office.com/mail/*", "https://outlook.cloud.microsoft/mail/*"],
      "js": ["src/content-outlook.ts"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "settings.html"
}
